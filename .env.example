# ─────────────────────────────────────────────────────────────────────────────
# AgriLearn — Environment Variables Reference
# Copy this to .env for local dev. Never commit .env to git.
# On Railway, set these in the service's Variables panel.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (set automatically by Railway PostgreSQL plugin) ─────────────────
# Railway provides PGHOST, PGPORT, PGDATABASE, PGUSER, PGPASSWORD automatically.
# For local dev only:
DB_URL=jdbc:postgresql://localhost:5432/agrilearn
DB_USERNAME=agrilearn
DB_PASSWORD=agrilearn123

# ── JWT ───────────────────────────────────────────────────────────────────────
# MUST change in production — min 64 characters, random string
JWT_SECRET=change-me-to-a-very-long-random-secret-at-least-64-characters-long!!

# ── MinIO (S3-compatible file storage) ────────────────────────────────────────
# Local dev: http://localhost:9000
# Railway: set to your MinIO service URL or Cloudflare R2 endpoint
MINIO_URL=http://localhost:9000
MINIO_ACCESS_KEY=agrilearn
MINIO_SECRET_KEY=agrilearn123

# ── Email (optional — for password reset emails) ──────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# ── Razorpay (optional — for payments) ────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Frontend ──────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=https://your-backend.railway.app/api/v1
