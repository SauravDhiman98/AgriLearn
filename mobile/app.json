{
  "expo": {
    "name": "AgriLearn",
    "slug": "agrilearn",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#16a34a"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.agrilearn.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#16a34a"
      },
      "package": "in.agrilearn.app",
      "jsEngine": "hermes"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "apiBaseUrl": "https://agrilearn-production.up.railway.app/api/v1",
      "eas": {
        "projectId": "684df1dc-5551-46f7-9539-62e1e37c397e"
      }
    },
    "updates": {
      "enabled": false
    },
    "plugins": [
      "expo-secure-store"
    ]
  }
}
